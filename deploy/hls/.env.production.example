# Copy this file to .env on the production server and replace every secret.
# Keep this file out of git if you put real values in it.

# Stable Docker Compose project name. Backup script depends on this volume prefix.
COMPOSE_PROJECT_NAME=dittofeed

# Production domain.
DASHBOARD_URL=https://newsletter.hls.md
DASHBOARD_API_BASE=https://newsletter.hls.md
ALLOWED_ORIGINS=https://newsletter.hls.md
SESSION_COOKIE_SECURE=true

# Change these before exposing the app.
DATABASE_USER=dittofeed_prod
DATABASE_PASSWORD=replace-with-long-random-password
CLICKHOUSE_USER=dittofeed
CLICKHOUSE_PASSWORD=replace-with-long-random-password
PASSWORD=replace-with-admin-login-password
SECRET_KEY=replace-with-generated-secret-key

# Optional but clearer in the dashboard.
WORKSPACE_NAME=HLS
AUTH_MODE=single-tenant

# Keep bootstrap true only for the first start. Set BOOTSTRAP=false after initial setup.
BOOTSTRAP=true

# Pin the image tag you intend to run. The repo default is v0.23.0.
IMAGE_TAG=v0.23.0

# Performance tuning. Increase these if the VPS has enough RAM.
# Recommended minimum VPS: 4 GB RAM. Prefer 8 GB RAM for smoother ClickHouse usage.
LITE_MEM_LIMIT=1536
LITE_CONTAINER_MEM_LIMIT=2048
CLICKHOUSE_CONTAINER_MEM_LIMIT=3072
